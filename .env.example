# Campaign phase: awareness (default), persuasion, or campaign
# NEXT_PUBLIC_CAMPAIGN_PHASE=awareness

# Public donation/checkout URL (ActBlue, Anedot, Stripe Checkout, PayPal, etc.)
# NEXT_PUBLIC_DONATION_URL=https://secure.actblue.com/donate/your-page

# External merch storefront (Shopify, Printful, etc.)
# NEXT_PUBLIC_SHOP_URL=https://your-store.myshopify.com

# Google Maps — required for the interactive voting map (/map)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-cloud-map-id
